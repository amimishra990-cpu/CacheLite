{
  "name": "@hollowintent/cachelite",
  "version": "1.0.0",
  "description": "A lightweight, dependency-free in-memory caching library with TTL expiration, LRU eviction, async memoization, and TypeScript support for Node.js and JavaScript applications.",
  "main": "index.js",
  "module": "index.mjs",
  "types": "index.d.ts",
  "type": "commonjs",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.mts",
        "default": "./index.mjs"
      },
      "require": {
        "types": "./index.d.cts",
        "default": "./index.js"
      },
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "index.js",
    "index.mjs",
    "index.d.ts",
    "index.d.cts",
    "index.d.mts",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage",
    "prepublishOnly": "npm test",
    "example:basic": "node examples/basic.js",
    "example:ttl": "node examples/custom-ttl.js",
    "example:async": "node examples/async-cache.js",
    "example:esm": "node examples/esm.mjs"
  },
  "keywords": [
    "cache",
    "caching",
    "in-memory",
    "memory-cache",
    "ttl",
    "lru",
    "memoization",
    "nodejs",
    "javascript",
    "typescript",
    "esm",
    "commonjs",
    "zero-dependencies",
    "dependency-free",
    "lightweight"
  ],
  "author": {
    "name": "amimishra990-cpu",
    "url": "https://github.com/amimishra990-cpu"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amimishra990-cpu/CacheLite.git"
  },
  "bugs": {
    "url": "https://github.com/amimishra990-cpu/CacheLite/issues"
  },
  "homepage": "https://github.com/amimishra990-cpu/CacheLite#readme",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}
